## ONEPANEL Force HTTPS by SSL installation
RewriteEngine On

# Ép HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

# Bỏ .html khỏi URL
# Nếu file .html tồn tại thì cho phép truy cập mà không cần gõ .html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Ngược lại, nếu URL có .html thì redirect sang URL không có .html (SEO friendly)
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?]
RewriteRule ^ %1 [R=301,L]

# Thêm CSP
Header always set Content-Security-Policy "upgrade-insecure-requests;"
## ONEPANEL Force HTTPS by SSL installation end